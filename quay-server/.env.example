# ===== BẮT BUỘC =====
# Mật khẩu để nhân viên đăng nhập app (ít nhất 6 ký tự, nên dài và khó đoán)
SHOP_PASSWORD=doi-mat-khau-nay
# Địa chỉ web của app (dùng cho link thanh toán Stripe). Có tên miền thì ghi https://ten-mien
PUBLIC_URL=http://IP-CUA-VPS
# Tên miền cho HTTPS (vd: book.lumi-nails.com.au). Chưa có thì để :80
SITE_ADDRESS=:80
# Múi giờ của tiệm
TZ_SHOP=Australia/Melbourne

# ===== SMS (chọn MỘT) — để trống thì tắt SMS =====
# ClickSend (công ty Úc): https://dashboard.clicksend.com → API Credentials
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
# Tên người gửi hiện trên điện thoại khách (tối đa 11 ký tự, không dấu cách), vd: LumiNails
SMS_FROM=
# Hoặc Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ===== Bán thẻ quà tặng online (Stripe) — để trống thì tắt =====
# https://dashboard.stripe.com/apikeys → Secret key (sk_live_...)
STRIPE_SECRET_KEY=
# Webhook (khuyên dùng): Developers → Webhooks → Add endpoint
#   URL: https://ten-mien/api/stripe/webhook  · Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=
